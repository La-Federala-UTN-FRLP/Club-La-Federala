{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc && node scripts/copy-prisma-generated.cjs",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:app && npm run typecheck:test",
    "start": "node dist/server.js",
    "test": "jest",
    "test:validation": "jest tests/unit/validations --runInBand",
    "test:domain": "jest tests/unit/domain --runInBand",
    "test:service": "jest tests/unit/services --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed:core": "npx ts-node --transpile-only prisma/seeds/seed.users_inmobiliarias.ts",
    "seed:personas": "npx ts-node --transpile-only prisma/seeds/seed-personas.ts",
    "seed:lrv": "npx ts-node --transpile-only prisma/seeds/seed.lotes_reservas_ventas.ts",
    "jobs:expirations": "npx ts-node --transpile-only src/jobs/runExpirations.ts",
    "jobs:expirations:prod": "node dist/jobs/runExpirations.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "@supabase/supabase-js": "^2.58.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.2.1",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "prisma": "^6.18.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
