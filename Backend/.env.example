NODE_ENV=development
PORT=3000
# Un único origin (sin path ni CSV). Requerido en production.
FRONTEND_URL=http://localhost:5173

DATABASE_URL="postgresql://USER:PASSWORD@db.example.com:6543/app?pgbouncer=true"
# DIRECT_URL: solo tooling Prisma (migraciones, generate, seeds); el runtime no la exige.
DIRECT_URL="postgresql://USER:PASSWORD@db.example.com:5432/app"

# production: JWT_SECRET de al menos 32 caracteres. Rotarlo invalida los JWT emitidos.
JWT_SECRET=replace-with-a-long-random-secret
# Duración con unidad (2h, 30m, 1d). Un número sin unidad se rechaza.
JWT_EXPIRES_IN=2h

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-supabase-service-role-key
SUPABASE_BUCKET=lotes-files
