NODE_ENV=development
PORT=3000
# Un único origin (sin path ni CSV). Requerido en production.
FRONTEND_URL=http://localhost:5173

DATABASE_URL="postgresql://USER:PASSWORD@db.example.com:6543/app?pgbouncer=true"
# DIRECT_URL: solo tooling Prisma (migraciones, generate, seeds); el runtime no la exige.
DIRECT_URL="postgresql://USER:PASSWORD@db.example.com:5432/app"

# production: JWT_SECRET de al menos 32 caracteres. Rotarlo invalida los JWT emitidos.
JWT_SECRET=replace-with-a-long-random-secret
# Duración con unidad (2h, 30m, 1d). Un número sin unidad se rechaza.
JWT_EXPIRES_IN=2h

# supabase (default: Render y local) o gcs. Ausente o vacío = supabase.
# STORAGE_PROVIDER=supabase

# Obligatorias con el proveedor supabase. Con gcs pueden omitirse.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-supabase-service-role-key
SUPABASE_BUCKET=lotes-files

# Obligatorio solo con STORAGE_PROVIDER=gcs. Nombre del bucket, sin gs:// ni rutas.
# GCS_BUCKET=your-gcs-bucket

# Resumen con IA de Reportes (Gemini en Vertex AI). Opcionales: se validan al pedir un resumen,
# no al arrancar. Sin API key: autenticación por ADC (en Cloud Run, la service account del servicio).
# VERTEX_PROJECT=your-gcp-project-id
# global por defecto: el modelo no está disponible en southamerica-east1.
# VERTEX_LOCATION=global
# AI_SUMMARY_MODEL=gemini-3.5-flash-lite
