# Plantilla del entorno QA LOCAL y descartable (sin secretos).
# Copiar a Backend/.env.qa y completar los valores <...>. Backend/.env.qa no se versiona.
# Guía completa: docs/qa/preparacion-entorno-qa.md
#
# REGLA: estas variables apuntan SOLO a una base PostgreSQL local en Docker (127.0.0.1/localhost).
# Nunca a la base Supabase compartida de Backend/.env. seed:qa y qa:api abortan si DATABASE_URL no es local.

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
# Aleatorio, 48+ caracteres. Ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<aleatorio-48-o-mas-caracteres>
JWT_EXPIRES_IN=2h

# Contenedor Docker federala-qa-db (postgres:16)
QA_DB_CONTAINER=federala-qa-db
QA_DB_VOLUME=federala-qa-data
QA_DB_PORT=5433
QA_DB_USER=federala_qa
QA_DB_PASSWORD=<aleatorio>
QA_DB_NAME=federala_qa
DATABASE_URL=postgresql://federala_qa:<QA_DB_PASSWORD>@127.0.0.1:5433/federala_qa?schema=public
DIRECT_URL=postgresql://federala_qa:<QA_DB_PASSWORD>@127.0.0.1:5433/federala_qa?schema=public

# Storage desactivado a propósito: valores dummy para que el backend arranque sin tocar el bucket
# compartido. Subir, firmar URL o purgar archivos responde 500 en este entorno.
# STORAGE_PROVIDER queda en el default supabase. No hace falta GCS_BUCKET.
SUPABASE_URL=https://qa-storage.invalid
SUPABASE_SERVICE_KEY=qa-dummy-sin-storage
SUPABASE_BUCKET=lotes-files-qa

# API local para npm run qa:api
QA_API_URL=http://localhost:3001

# Contraseñas de las cuentas QA (generar aleatorias; nunca en docs, CSV ni Git)
QA_PASS_ADMIN=<aleatoria>
QA_PASS_GESTOR=<aleatoria>
QA_PASS_INMO_A=<aleatoria>
QA_PASS_INMO_B=<aleatoria>
QA_PASS_TECNICO=<aleatoria>
QA_PASS_AUX_ELIMINADO=<aleatoria>
QA_PASS_AUX_RATELIMIT=<aleatoria>
