# Modo development (vite / npm run dev).
#
# Base de la API: VITE_API_BASE_URL (incluye /api). No se fija acá a propósito:
# - sin valor, el cliente usa "/api" y el proxy de Vite (vite.config.js) lo manda a http://localhost:3000;
# - con un valor local (http://localhost:3000/api) también usa el proxy, salvo VITE_API_FORCE_ABSOLUTE=true;
# - para apuntar a otro backend, definirla en frontend/.env.local (no versionado; tiene prioridad).
# Ver frontend/.env.example.
VITE_APP_NAME=Mi App - DEV
