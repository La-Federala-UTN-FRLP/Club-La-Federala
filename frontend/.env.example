# Variables del frontend (Vite). Copiar a .env.local y ajustar.

# Base de la API, incluyendo /api. Nombre canónico.
#   development: con localhost se usa el proxy de Vite ("/api"), salvo VITE_API_FORCE_ABSOLUTE=true
#   production:  URL absoluta del backend, definida en el hosting (Vercel)
VITE_API_BASE_URL=http://localhost:3000/api

# true: usar VITE_API_BASE_URL tal cual también en development (sin proxy). Opcional.
VITE_API_FORCE_ABSOLUTE=false

# Clave de localStorage del token. Opcional (default lf_token).
# VITE_AUTH_TOKEN_KEY=lf_token

# true: desactiva el gating visual por rol (solo para maquetar; el backend sigue autorizando). Opcional.
# VITE_RBAC_DISABLE_UI=false

# Compatibilidad: VITE_API_BASE se lee si VITE_API_BASE_URL no está definida (legacy, no usar).
# VITE_API_URL y VITE_AUTH_REFRESH_* / VITE_AUTH_ME_PATH / VITE_AUTH_LOGIN_PATH no existen: no usar.
