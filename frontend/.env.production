# Modo production (vite build).
#
# VITE_API_BASE_URL (URL absoluta del backend, incluye /api) se define en el hosting
# (Vercel → Project Settings → Environment Variables), no en este archivo: las variables del
# entorno de build tienen prioridad y así el repo no fija el destino de producción.
# Si falta, el cliente usa "/api" relativo al dominio del frontend (sin backend detrás en Vercel).
VITE_APP_NAME=Mi App
